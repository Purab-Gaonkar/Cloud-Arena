## [animation, sheet file, fps, loops, folder]  (folder "" = Craftpix art, "gen" = tools/gen_sprites.py output)
const ANIMS: Array = [
	["idle",     "Idle",     8.0,  true],
	["run",      "Run",      14.0, true],
	["jump",     "Jump",     14.0, false],
	["attack_1", "Attack_1", 14.0, false],
	["attack_2", "Attack_2", 14.0, false],
	["attack_3", "Attack_3", 14.0, false],
	["block",    "Shield",   12.0, false],
	["hit",      "Hurt",     12.0, false],
	["ko",       "Dead",     8.0,  false],
	["heavy",        "Heavy",        14.0, false, "gen"],
	["super_windup", "Super_Windup", 10.0, false, "gen"],
	["super_strike", "Super_Strike", 12.0, false, "gen"],
	["super_end",    "Super_End",    10.0, false, "gen"],
]


static func get_fighter(char_id: String) -> Dictionary:
	for f in ROSTER:
		if f["id"] == char_id:
			return f
	return ROSTER[0]


static func build_frames(char_id: String) -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.remove_animation("default")
	for spec in ANIMS:
		var anim: String = spec[0]
		var dir: String = GEN_DIR if spec.size() > 4 else BASE_DIR
		var sheet: Texture2D = load("%s%s/%s.png" % [dir, char_id, spec[1]])
		if sheet == null:
			push_warning("[FighterData] Missing sheet %s/%s" % [char_id, spec[1]])
			continue
		frames.add_animation(anim)
		frames.set_animation_speed(anim, spec[2])
		frames.set_animation_loop(anim, spec[3])
		var count: int = sheet.get_width() / FRAME_SIZE
		for i in range(count):
			var atlas := AtlasTexture.new()
			atlas.atlas  = sheet
			atlas.region = Rect2(i * FRAME_SIZE, 0, FRAME_SIZE, FRAME_SIZE)
			frames.add_frame(anim, atlas)
	return frames


## One SpriteFrames holding every FX sheet as its own animation (see FX).
static func build_fx_frames() -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.remove_animation("default")
	for fx_name in FX:
		var spec: Array = FX[fx_name]
		var sheet: Texture2D = load("%sfx/%s.png" % [GEN_DIR, fx_name])
		if sheet == null:
			push_warning("[FighterData] Missing FX sheet %s" % fx_name)
			continue
		frames.add_animation(fx_name)
		frames.set_animation_speed(fx_name, spec[3])
		frames.set_animation_loop(fx_name, spec[4])
		for i in range(spec[2]):
			var atlas := AtlasTexture.new()
			atlas.atlas  = sheet
			atlas.region = Rect2(i * spec[0], 0, spec[0], spec[1])
			frames.add_frame(fx_name, atlas)
	return frames
